# Required for LLM scoring and podcast script generation
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# Optional: override the model used for podcast scripts (default: claude-sonnet-4-5-20250929)
# DISTILL_SCRIPT_MODEL=claude-sonnet-4-5-20250929

# Podcastfy can use Anthropic, OpenAI, or Gemini for its script; only the chosen
# provider's key is needed for Podcastfy. Scoring still uses ANTHROPIC_API_KEY.
# OPENAI_API_KEY=your-openai-api-key
# Select models under podcast.podcastfy.models in config.yaml.
# These are provider API keys, not Claude Code/Codex account sign-ins.

# For gemini-api-tts (default): create a key at https://aistudio.google.com/api-keys.
# Keep the project on the free tier to use free Flash TTS quota without enabling billing.
# GOOGLE_API_KEY is also accepted; GEMINI_API_KEY takes precedence.
# GEMINI_API_KEY=your-gemini-api-key

# Optional for gemini-tts: project for Google's official Cloud Text-to-Speech API.
# Alternatively set podcast.gemini_project in config.yaml.
# GOOGLE_CLOUD_PROJECT=your-project-id
# Authenticate locally with: gcloud auth application-default login
# On a server, use Application Default Credentials via its service identity.
